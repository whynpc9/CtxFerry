---
import harbor from "../assets/harbor.webp";
import { landingCopy, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = landingCopy[locale].firstRun;
---

<figure class="field-guide">
  <img class="art" src={harbor.src} width="1536" height="1024" alt={copy.imageAlt} />
  <figcaption class="shell">
    <h2 class="shell-title"><svg class="icon" aria-hidden="true"><use href="#terminal"/></svg>{copy.title}</h2>
    <p class="shell-note">{copy.note}</p>
    <pre aria-label={copy.commandsLabel}><code><span>$</span> ctxferry init
<span>$</span> ctxferry project bind <b>.</b>
<span>$</span> ctxferry context show</code></pre>
    <p class="shell-result"><strong>{copy.resultLabel}</strong>{copy.result}</p>
  </figcaption>
</figure>
