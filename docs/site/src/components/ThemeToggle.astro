---
interface Props {
  darkLabel: string;
  lightLabel: string;
}
const { darkLabel, lightLabel } = Astro.props;
---

<button
  class="theme-toggle"
  type="button"
  aria-label={darkLabel}
  title={darkLabel}
  data-dark-label={darkLabel}
  data-light-label={lightLabel}
>
  <svg class="icon theme-icon-dark" aria-hidden="true"><use href="#moon"></use></svg>
  <svg class="icon theme-icon-light" aria-hidden="true"><use href="#sun"></use></svg>
</button>
<script is:inline>
  (() => {
    const root = document.documentElement;
    const buttons = document.querySelectorAll(".theme-toggle");
    const label = () => {
      buttons.forEach((button) => {
        const text =
          root.dataset.theme === "dark"
            ? button.dataset.lightLabel
            : button.dataset.darkLabel;
        button.setAttribute("aria-label", text);
        button.title = text;
      });
    };
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        window.ctxferryTheme?.toggle();
        label();
      }),
    );
    new MutationObserver(label).observe(root, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    label();
  })();
</script>
