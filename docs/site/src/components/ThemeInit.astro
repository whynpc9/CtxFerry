<!-- Resolve the theme before first paint. Without JavaScript, `color-scheme: light dark` follows the system. -->
<script is:inline>
  (() => {
    const key = "ctxferry-theme";
    const media = matchMedia("(prefers-color-scheme: dark)");
    const stored = () => {
      try {
        const value = localStorage.getItem(key);
        return value === "light" || value === "dark" ? value : null;
      } catch {
        return null;
      }
    };
    const apply = () => {
      document.documentElement.dataset.theme =
        stored() ?? (media.matches ? "dark" : "light");
    };
    apply();
    media.addEventListener("change", () => stored() || apply());
    window.ctxferryTheme = {
      toggle() {
        const next =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        try {
          localStorage.setItem(key, next);
        } catch {}
        document.documentElement.dataset.theme = next;
      },
    };
  })();
</script>
