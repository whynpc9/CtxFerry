---
import { landingCopy, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = landingCopy[locale].notePolicy;
---

<article class="note-sheet">
  <header><svg class="feature-icon" aria-hidden="true"><use href="#note"/></svg><div><span>{copy.example}</span><h3>{copy.title}</h3></div></header>
  <div class="choices">
    <section><div class="setting"><svg class="feature-icon" aria-hidden="true"><use href="#summary"/></svg><code>--disclosure summary</code></div>
      <h4>{copy.summaryTitle}</h4>
      <blockquote>{copy.summary}</blockquote>
      <p>{copy.summaryNote}</p>
    </section>
    <section><div class="setting"><svg class="feature-icon" aria-hidden="true"><use href="#publish"/></svg><code>--storage shared</code></div>
      <h4>{copy.sharedTitle}</h4>
      <div class="body-copy">{copy.body}</div>
      <p>{copy.sharedNote}</p>
    </section>
  </div>
  <div class="storage-option"><strong>{copy.localTitle}</strong><code>--storage local-only</code><span>{copy.localNote}</span></div>
</article>
