---
import { landingCopy, type Locale } from "../i18n";

interface Props {
  docsUrl: string;
  locale: Locale;
}
const { docsUrl, locale } = Astro.props;
const groups = landingCopy[locale].guideGroups;
---

<div class="guide-index">
  {groups.map((group, i) => (
    <section aria-labelledby={`guide-group-${i}`}>
      <h3 id={`guide-group-${i}`}><span>{String(i + 1).padStart(2, "0")}</span>{group.label}</h3>
      <ul>
        {group.links.map(([slug, title]) => (
          <li><a href={`${docsUrl}${slug}/`}>{title}<svg class="icon" aria-hidden="true"><use href="#arrow"/></svg></a></li>
        ))}
      </ul>
    </section>
  ))}
</div>
