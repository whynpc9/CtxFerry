---
import { getCollection } from "astro:content";
import {
  getDocsPage,
  getDocsStaticPaths,
} from "@cloudflare/nimbus-docs/runtime";
import GuideNavigation from "../components/GuideNavigation.astro";
import FerrySymbols from "../components/FerrySymbols.astro";
import ThemeInit from "../components/ThemeInit.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/docs.css";

export const getStaticPaths = getDocsStaticPaths;
const page = await getDocsPage(Astro);
if (page instanceof Response) return page;
const { entry, Content } = page;
const home = import.meta.env.BASE_URL;
const titles = new Map(
  (await getCollection("docs")).map((doc) => [doc.id, doc.data.title]),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{entry.data.title} · CtxFerry</title>
    <ThemeInit />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <FerrySymbols />
    <a class="skip" href="#article">Skip to guide</a>
    <header class="mast">
      <div class="bar">
        <a class="brand" href={home}
          ><span class="mark"
            ><svg aria-hidden="true"><use href="#ferry"></use></svg></span
          >CtxFerry</a
        >
        <a href={home + "docs/"}>Docs</a>
        <a class="repository" href="https://github.com/whynpc9/CtxFerry"
          >GitHub ↗</a
        >
        <ThemeToggle />
      </div>
    </header>
    <main class="guide-layout">
      <aside class="sidebar">
        <GuideNavigation current={entry.id} titles={titles} />
      </aside>
      <details class="mobile-nav">
        <summary>Browse guides</summary><GuideNavigation
          current={entry.id}
          titles={titles}
        />
      </details>
      <article id="article" data-pagefind-body>
        <h1>{entry.data.title}</h1><Content />
      </article>
    </main>
  </body>
</html>
