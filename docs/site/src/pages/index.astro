---
import FerrySymbols from "../components/FerrySymbols.astro";
import FirstRun from "../components/FirstRun.astro";
import GuideIndex from "../components/GuideIndex.astro";
import NotePolicy from "../components/NotePolicy.astro";
import ThemeInit from "../components/ThemeInit.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/landing.css";
const homeUrl = import.meta.env.BASE_URL;
const docsUrl = homeUrl + "docs/";
const githubUrl = "https://github.com/whynpc9/CtxFerry";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CtxFerry — Local-first development context</title>
  <ThemeInit />
  <meta name="description" content="Bind local project context, choose what agents can read, and sync selected notes to your private GitHub repository.">
</head>
<body>
  <FerrySymbols />
  <header class="wrap mast">
    <a href={homeUrl} class="brand" aria-label="CtxFerry home"><svg aria-hidden="true"><use href="#ferry"/></svg>CtxFerry</a>
    <nav aria-label="Main"><a href={docsUrl}>Docs</a><a href={githubUrl}>GitHub <svg class="icon" aria-hidden="true"><use href="#out"/></svg></a><ThemeToggle /></nav>
  </header>
  <main id="top">
    <section class="wrap hero" aria-labelledby="hero-title">
      <div class="intro">
        <p class="eyebrow">Local-first · CLI and native desktop</p>
        <h1 id="hero-title">Project context,<br><em>ready to travel.</em></h1>
        <p class="lead">CtxFerry keeps development context for each project on your device. Give agents concise summaries, and sync only the notes you choose to your private GitHub repo.</p>
        <div class="actions">
          <a class="cta" href={docsUrl + "getting-started/"}>Get started <svg class="icon" aria-hidden="true"><use href="#arrow"/></svg></a>
          <a class="text-link" href={docsUrl}>Browse the guides</a>
        </div>
      </div>
      <FirstRun />
    </section>
    <section class="policy" aria-labelledby="note-policy">
      <div class="wrap band">
        <div class="section-heading">
          <h2 id="note-policy">One note, two decisions.</h2>
          <p>These settings apply together. An agent can read a summary while sync sends the same note’s full body to your dedicated private GitHub repository.</p>
        </div>
        <NotePolicy />
      </div>
    </section>
    <section class="wrap band" aria-labelledby="guides-title">
      <div class="section-heading">
        <h2 id="guides-title">Find your guide.</h2>
        <p>Start with one checkout and no login. Add Tasks, credential references, Skills and private sync when you need them.</p>
      </div>
      <GuideIndex docsUrl={docsUrl} />
    </section>
  </main>
  <footer class="wrap">
    <a href={homeUrl} class="brand" aria-label="CtxFerry home"><svg aria-hidden="true"><use href="#ferry"/></svg>CtxFerry</a>
    <nav aria-label="Footer"><a href={docsUrl}>Docs</a><a href={githubUrl}>GitHub <svg class="icon" aria-hidden="true"><use href="#out"/></svg></a></nav>
  </footer>
</body>
</html>
